{
  "name": "working-hours-api",
  "version": "1.0.0",
  "description": "A simple API that takes a date and time and adds working days and or working hours to it. Colombian work hours considered.",
  "keywords": [
    "api",
    "working-hours"
  ],
  "homepage": "https://github.com/diegof59/working-hours-api#readme",
  "bugs": {
    "url": "https://github.com/diegof59/working-hours-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegof59/working-hours-api.git"
  },
  "license": "MIT",
  "author": "diegof59",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "express": "^5.1.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
